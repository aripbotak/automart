generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  BUYER
  DEALER
  ADMIN
}

enum VehicleCondition {
  BRAND_NEW
  USED
  CERTIFIED_PRE_OWNED
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
  DUAL_CLUTCH
  CVT
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUG_IN_HYBRID
  ELECTRIC
}

enum BodyType {
  SUV
  SEDAN
  HATCHBACK
  COUPE
  TRUCK
  CONVERTIBLE
  VAN
  WAGON
}

enum Drivetrain {
  FWD
  RWD
  AWD
  FOUR_WD
}

enum InquiryStatus {
  PENDING
  CONTACTED
  SCHEDULED
  CLOSED
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  password         String
  role             Role      @default(BUYER)
  phone            String?
  avatar           String?
  companyName      String?
  isVerifiedDealer Boolean   @default(false)
  city             String?
  state            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vehicles         Vehicle[]
  inquiries        Inquiry[]

  @@map("users")
}

model Vehicle {
  id            String           @id @default(uuid())
  title         String
  brand         String
  model         String
  year          Int
  price         Decimal          @db.Decimal(12, 2)
  originalPrice Decimal?         @db.Decimal(12, 2)
  mileage       Int
  transmission  TransmissionType @default(AUTOMATIC)
  fuelType      FuelType         @default(PETROL)
  bodyType      BodyType         @default(SUV)
  condition     VehicleCondition @default(USED)
  engine        String
  horsepower    Int
  drivetrain    Drivetrain       @default(AWD)
  exteriorColor String
  interiorColor String
  vin           String           @unique
  description   String           @db.Text
  features      String[]
  featured      Boolean          @default(false)
  status        VehicleStatus    @default(AVAILABLE)

  sellerId      String
  seller        User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  images        VehicleImage[]
  inquiries     Inquiry[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([brand, model])
  @@index([price])
  @@index([year])
  @@index([status])
  @@map("vehicles")
}

model VehicleImage {
  id        String   @id @default(uuid())
  vehicleId String
  imageUrl  String
  publicId  String?
  isPrimary Boolean  @default(false)
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

model Inquiry {
  id               String        @id @default(uuid())
  vehicleId        String
  userId           String?
  name             String
  email            String
  phone            String
  message          String        @db.Text
  preferredDate    DateTime?
  requestTestDrive Boolean       @default(true)
  tradeInInterest  Boolean       @default(false)
  status           InquiryStatus @default(PENDING)

  vehicle          Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([vehicleId])
  @@index([userId])
  @@map("inquiries")
}
